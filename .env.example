# Configuration names only. Supply values privately through the process environment.
# This app does not load .env automatically. Never commit real values.
# Production requires SECRET_KEY_BASE or encrypted Rails credentials.
# SECRET_KEY_BASE=
# Optional independent Refile signing key; omit to derive from Rails' private key.
# REFILE_SECRET_KEY=
# Optional initial admin; supply BOTH or omit BOTH. Existing accounts are unchanged.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# Optional development/test customers; never enabled in production.
# SEED_DEMO_USERS=true
# SEED_CUSTOMER_PASSWORD=
